# Copy to .env. Never commit .env.

# The voice: hearing, thinking, speaking.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=          # text-to-speech access is enough

# Optional overrides
# LLM_MODEL=gpt-4.1-mini
# STT_MODEL=nova-3
# TTS_VOICE_ID=cgSgspJ2msm6clMCkdW9

# Your LiveKit project, for `worker dev` (not needed for `worker console`).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
