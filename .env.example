# Copy to .env. Never commit .env.

# Hearing and thinking.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# Speaking. Providers are tried in this order, and the next one takes over when
# one fails or runs out of credit. Any of: deepgram, openai, elevenlabs.
# Deepgram and OpenAI use the two keys above; ElevenLabs needs its own.
# TTS_PROVIDERS=deepgram,openai
# ELEVENLABS_API_KEY=

# Optional overrides
# LLM_MODEL=gpt-4.1-mini
# STT_MODEL=nova-3

# Your LiveKit project, for `worker start` (not needed for `worker console`).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: also store each call in Postgres (`docker compose up -d db`).
# Without it a call's record is the JSON file in recordings/ only.
# DATABASE_URL=postgresql://clinic:clinic-local-only@127.0.0.1:54329/clinic

# What a call may cost: seconds before a call is ended, and calls allowed per day.
# MAX_CALL_SECONDS=300
# DAILY_CALL_CAP=25

# Phone numbers allowed to call in, E.164, comma-separated. Empty admits no phone caller.
# ALLOWED_NUMBERS=+14155550123
